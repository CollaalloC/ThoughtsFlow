{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "io.thoughsflow.desktop.webview-e2e",
  "bundle": {
    "active": false
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "webview-e2e",
          "description": "Test-only access for the embedded macOS WebDriver server.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
